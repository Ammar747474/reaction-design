<mxfile host="app.diagrams.net"><diagram name="Context" id="context"><mxGraphModel dx="1100" dy="520" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="520"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="Context-title" value="Context view: React to a post (class proposal)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry" /></mxCell><mxCell id="Context-sys" value="Facebook Post Workflow&lt;br&gt;(the system, shown as one box)&lt;br&gt;React to a post" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="300" height="150" as="geometry" /></mxCell><mxCell id="Context-user" value="User&lt;br&gt;(sample user)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="190" height="80" as="geometry" /></mxCell><mxCell id="Context-data" value="Sample Data Source&lt;br&gt;(simulated users and posts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="225" width="230" height="80" as="geometry" /></mxCell><mxCell id="Context-notif" value="Notification service&lt;br&gt;(simulated, not built)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="830" y="60" width="230" height="80" as="geometry" /></mxCell><mxCell id="Context-leg" value="Rectangles: people and software. Dashed: simulated or out of scope. Every arrow is labeled with its purpose." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1040" height="50" as="geometry" /></mxCell><mxCell id="Context-e2" value="Select a reaction, view posts" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="Context-user" target="Context-sys"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset" /></mxGeometry></mxCell><mxCell id="Context-e3" value="Updated counts or&lt;br&gt;error message" style="endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="Context-sys" target="Context-user"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="22" as="offset" /></mxGeometry></mxCell><mxCell id="Context-e4" value="Load sample users&lt;br&gt;and posts" style="endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="Context-data" target="Context-sys"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-24" as="offset" /></mxGeometry></mxCell><mxCell id="Context-e5" value="Reaction notice (out of scope)" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;exitX=0.85;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="Context-sys" target="Context-notif"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="635" y="100" /></Array><mxPoint x="-10" y="-14" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Applications" id="applications"><mxGraphModel dx="1100" dy="500" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="500"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="Applications-title" value="Application view: where each application and data store runs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry" /></mxCell><mxCell id="Applications-cli" value="Web Client&lt;br&gt;(browser application)&lt;br&gt;&lt;br&gt;Runs on: the user&amp;#x27;s browser,&lt;br&gt;on the local test machine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="250" height="150" as="geometry" /></mxCell><mxCell id="Applications-srv" value="Application Server&lt;br&gt;(one server application)&lt;br&gt;&lt;br&gt;Runs on: the course / local&lt;br&gt;test machine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="270" height="150" as="geometry" /></mxCell><mxCell id="Applications-db" value="Reaction Database&lt;br&gt;(users, posts, reactions)&lt;br&gt;&lt;br&gt;Runs on: the same local&lt;br&gt;machine. Technology:&lt;br&gt;undecided (OD2)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="850" y="160" width="210" height="170" as="geometry" /></mxCell><mxCell id="Applications-note" value="Client-server pattern: the client sends requests and the server decides. The browser holds no rules.&lt;br&gt;Three deployed tiers: Web Client, Application Server, Database. Hosting is a local course machine (constraint C2); no paid cloud.&lt;br&gt;Rectangles = software, cylinder = data store." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1020" height="90" as="geometry" /></mxCell><mxCell id="Applications-e2" value="HTTP request:&lt;br&gt;select reaction&lt;br&gt;(postId, type, requestId)" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="Applications-cli" target="Applications-srv"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-40" as="offset" /></mxGeometry></mxCell><mxCell id="Applications-e3" value="HTTP response:&lt;br&gt;counts or error" style="endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="Applications-srv" target="Applications-cli"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="30" as="offset" /></mxGeometry></mxCell><mxCell id="Applications-e4" value="Read and write&lt;br&gt;posts and reactions&lt;br&gt;(local DB connection)" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="Applications-srv" target="Applications-db"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-42" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Components" id="components"><mxGraphModel dx="1120" dy="700" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="Components-title" value="Component view: inside the Application Server" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry" /></mxCell><mxCell id="Components-cli" value="Web Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="140" height="90" as="geometry" /></mxCell><mxCell id="Components-bnd" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6C8EBF;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="60" width="900" height="470" as="geometry" /></mxCell><mxCell id="Components-bndl" value="Application Server (one process)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="64" width="420" height="24" as="geometry" /></mxCell><mxCell id="Components-api" value="API Handler&lt;br&gt;&lt;br&gt;Responsibility: receive the&lt;br&gt;request, identify the caller&lt;br&gt;from the session, return&lt;br&gt;the result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="120" width="200" height="150" as="geometry" /></mxCell><mxCell id="Components-rs" value="Reaction Service&lt;br&gt;&lt;br&gt;Responsibility: apply rules&lt;br&gt;S1, S2 result, S3, and&lt;br&gt;requestId retry. ONLY part&lt;br&gt;that changes Reaction records" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="220" height="150" as="geometry" /></mxCell><mxCell id="Components-ps" value="Post Service&lt;br&gt;&lt;br&gt;Responsibility: say whether&lt;br&gt;a post exists and is&lt;br&gt;Published. ONLY part that&lt;br&gt;changes Post status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="120" width="240" height="150" as="geometry" /></mxCell><mxCell id="Components-da" value="Data Access&lt;br&gt;&lt;br&gt;Responsibility: run protected&lt;br&gt;reads and writes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="340" width="220" height="110" as="geometry" /></mxCell><mxCell id="Components-db" value="Reaction Database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="560" width="220" height="110" as="geometry" /></mxCell><mxCell id="Components-n1" value="Boundary: Reaction Service owns all&lt;br&gt;Reaction rules and writes, so related&lt;br&gt;work stays in one place. Other parts&lt;br&gt;call its interface and never touch&lt;br&gt;Reaction data directly." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="215" y="330" width="260" height="150" as="geometry" /></mxCell><mxCell id="Components-n2" value="Code layers: API, Services, Data Access.&lt;br&gt;Deployed tiers: Web Client, Application Server,&lt;br&gt;Database. All four components share one server&lt;br&gt;process, so layers are not separate tiers." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="440" height="100" as="geometry" /></mxCell><mxCell id="Components-e2" value="HTTP request" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="Components-cli" target="Components-api"><mxGeometry relative="1" as="geometry"><mxPoint x="-4" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Components-e3" value="setReaction(postId,&lt;br&gt;userId, type, requestId)" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="Components-api" target="Components-rs"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-30" as="offset" /></mxGeometry></mxCell><mxCell id="Components-e4" value="isPublished(postId)" style="endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="Components-rs" target="Components-ps"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Components-e5" value="save or delete Reaction;&lt;br&gt;read counts" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="Components-rs" target="Components-da"><mxGeometry relative="1" as="geometry"><mxPoint x="86" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="Components-e6" value="read Post" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="Components-ps" target="Components-da"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="395" /></Array><mxPoint x="-110" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Components-e7" value="SQL, local connection" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="Components-da" target="Components-db"><mxGeometry relative="1" as="geometry"><mxPoint x="82" y="0" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Sequence" id="sequence"><mxGraphModel dx="1260" dy="770" grid="1" gridSize="10" page="1" pageWidth="1260" pageHeight="770"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="Sequence-e2" value="" style="endArrow=none;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="88" as="sourcePoint" /><mxPoint x="110" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="Sequence-e3" value="" style="endArrow=none;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="88" as="sourcePoint" /><mxPoint x="300" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="Sequence-e4" value="" style="endArrow=none;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="88" as="sourcePoint" /><mxPoint x="490" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="Sequence-e5" value="" style="endArrow=none;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="88" as="sourcePoint" /><mxPoint x="680" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="Sequence-e6" value="" style="endArrow=none;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="88" as="sourcePoint" /><mxPoint x="870" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="Sequence-e7" value="" style="endArrow=none;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="88" as="sourcePoint" /><mxPoint x="1060" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="Sequence-title" value="Sequence view: one successful request (S1: Ali selects Like on Published post P1)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="900" height="28" as="geometry" /></mxCell><mxCell id="Sequence-hUser" value="User" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="160" height="44" as="geometry" /></mxCell><mxCell id="Sequence-hWeb Client" value="Web Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="44" width="160" height="44" as="geometry" /></mxCell><mxCell id="Sequence-hAPI Handler" value="API Handler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="44" width="160" height="44" as="geometry" /></mxCell><mxCell id="Sequence-hReaction Service" value="Reaction Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="44" width="160" height="44" as="geometry" /></mxCell><mxCell id="Sequence-hPost Service" value="Post Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="44" width="160" height="44" as="geometry" /></mxCell><mxCell id="Sequence-hReaction Database" value="Reaction Database" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="44" width="160" height="44" as="geometry" /></mxCell><mxCell id="Sequence-acc" value="3: ACCESS CHECK: caller = Ali&lt;br&gt;(identity from session)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="194" width="220" height="36" as="geometry" /></mxCell><mxCell id="Sequence-sv" value="SAVED CHANGE&lt;br&gt;(Reaction stored)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1074" y="464" width="150" height="36" as="geometry" /></mxCell><mxCell id="Sequence-leg" value="Solid arrow = request. Dashed arrow = reply. Orange = access check. Green = saved change." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="1200" height="24" as="geometry" /></mxCell><mxCell id="Sequence-e8" value="1: select Like on post P1" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="120" as="sourcePoint" /><mxPoint x="300" y="120" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e9" value="2: POST /posts/P1/reaction {Like, requestId}" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="166" as="sourcePoint" /><mxPoint x="490" y="166" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e10" value="4: setReaction(P1, Ali, Like, requestId)" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="258" as="sourcePoint" /><mxPoint x="680" y="258" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e11" value="5: isPublished(P1)" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="304" as="sourcePoint" /><mxPoint x="870" y="304" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e12" value="6: read Post P1" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="350" as="sourcePoint" /><mxPoint x="1060" y="350" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e13" value="7: status = Published" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="396" as="sourcePoint" /><mxPoint x="870" y="396" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e14" value="8: Published (check passed)" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="442" as="sourcePoint" /><mxPoint x="680" y="442" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e15" value="9: find Reaction(P1, Ali): none; INSERT Reaction" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="488" as="sourcePoint" /><mxPoint x="1060" y="488" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e16" value="10: saved; counts per type" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="534" as="sourcePoint" /><mxPoint x="680" y="534" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e17" value="11: result (counts, my reaction = Like)" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="580" as="sourcePoint" /><mxPoint x="490" y="580" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e18" value="12: 200 OK {counts}" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="626" as="sourcePoint" /><mxPoint x="300" y="626" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="Sequence-e19" value="13: Like count shows 1 more" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="672" as="sourcePoint" /><mxPoint x="110" y="672" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>